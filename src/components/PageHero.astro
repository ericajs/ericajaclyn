---
// Figma: pageHeader (22195:42616) — centered content block with optional
// brow (custom/brow), a Kepler display heading and an optional description.
// Shared by UX Design, Space, About, Contact and the case study pages.
//
// Responsive ranges follow the per-page Responsive Specs tables
// (≤640 / ≤768 / ≤1024 / >1024), so breakpoints are inclusive max-widths
// expressed mobile-first as min-[641px] / min-[769px] / min-[1025px]:
//
//              ≤640   ≤768   ≤1024   >1024
//   padding     56     64     80      96
//   gap         24     32     40      48
//   heading   54/56  54/60  68/72   68/72   (Kepler 3 Display Extended Light)
//   content    512    512    512     512
//   description 14/20 muted at every width
//
// `lgAtMd`: the UX Design page keeps lg padding/gap (96/48) through the
// ≤1024 range (Figma UX Responsive Specs; spec decision log "UX1024").
interface Props {
  title: string
  eyebrow?: string
  description?: string
  lgAtMd?: boolean
}
const { title, eyebrow, description, lgAtMd = false } = Astro.props

const pad = lgAtMd
  ? "p-14 min-[641px]:p-16 min-[769px]:p-24"
  : "p-14 min-[641px]:p-16 min-[769px]:p-20 min-[1025px]:p-24"
const gap = lgAtMd
  ? "gap-6 min-[641px]:gap-8 min-[769px]:gap-12"
  : "gap-6 min-[641px]:gap-8 min-[769px]:gap-10 min-[1025px]:gap-12"
const heading =
  "font-serif-heading font-light tracking-normal text-foreground text-[54px] leading-[56px] min-[641px]:leading-[60px] min-[769px]:text-[68px] min-[769px]:leading-[72px]"
---
<header class:list={["flex flex-col items-center bg-background", pad]}>
  <div class:list={["flex w-full max-w-lg flex-col items-center text-center", gap]}>
    {eyebrow ? (
      <hgroup class:list={["flex w-full flex-col items-center", gap]}>
        <p class="brow">{eyebrow}</p>
        <h1 class={heading}>{title}</h1>
      </hgroup>
    ) : (
      <h1 class={heading}>{title}</h1>
    )}
    {description && (
      <p class="w-full text-sm font-normal text-muted-foreground">{description}</p>
    )}
  </div>
</header>
