---
// Figma: pageHero (22195:42616) — centered TitleBlock with optional brow
// (tagline) and optional Slot description. Shared by UX Design,
// Astrophotography, About and Contact.
//
// Responsive ranges follow the per-page Responsive Specs tables
// (≤640 / ≤768 / ≤1024 / >1024), so breakpoints are inclusive max-widths
// expressed mobile-first as min-[641px] / min-[769px] / min-[1025px]:
//
//              ≤640   ≤768   ≤1024   >1024
//   padding     40     56     64      96
//   gap         24     32     40      48
//   heading   30/36  30/36  48/48   48/48
//   titleBlock 512    512    672     672
//   slot text 18/26  18/26  16/24   16/24
//
// `lgAtMd`: the UX Design page keeps lg padding/gap (96/48) through the
// ≤1024 range (Figma UX Responsive Specs; spec decision log "UX1024").
interface Props {
  title: string
  eyebrow?: string
  description?: string
  lgAtMd?: boolean
}
const { title, eyebrow, description, lgAtMd = false } = Astro.props

const pad = lgAtMd
  ? "p-10 min-[641px]:p-14 min-[769px]:p-24"
  : "p-10 min-[641px]:p-14 min-[769px]:p-16 min-[1025px]:p-24"
const gap = lgAtMd
  ? "gap-6 min-[641px]:gap-8 min-[769px]:gap-12"
  : "gap-6 min-[641px]:gap-8 min-[769px]:gap-10 min-[1025px]:gap-12"
const heading = "text-3xl font-semibold text-foreground min-[769px]:text-5xl"
---
<header class:list={["flex flex-col items-center bg-background", pad]}>
  <div class:list={["flex w-full max-w-lg flex-col items-center text-center min-[769px]:max-w-2xl", gap]}>
    {eyebrow ? (
      <hgroup class:list={["flex w-full flex-col items-center", gap]}>
        <p class="text-sm font-semibold uppercase tracking-[1px] text-accent [text-box:trim-both_cap_alphabetic]">
          {eyebrow}
        </p>
        <h1 class={heading}>{title}</h1>
      </hgroup>
    ) : (
      <h1 class={heading}>{title}</h1>
    )}
    {description && (
      <div class="w-full max-w-lg">
        <p class="text-lg/[26px] font-light text-muted-foreground min-[769px]:text-base">{description}</p>
      </div>
    )}
  </div>
</header>
