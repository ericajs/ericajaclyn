---
import Logo from "@/components/Logo.astro"
import ThemeToggle from "@/components/ThemeToggle.astro"

const leftNav = [
  { href: "/uxdesign", label: "UX Design" },
  { href: "/astrophotography", label: "Astrophotography" },
]
const rightNav = [
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
]

const currentPath = Astro.url.pathname
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href)
---
{/* Header is fluid edge-to-edge — no max-width, per the Figma build note. */}
<header class="w-full px-[var(--page-px)] py-3 min-h-[68px] flex items-center">
  <div class="w-full">

    {/* Desktop — links left, centered logo, links + theme toggle right */}
    <div class="hidden lg:flex items-center">
      <nav aria-label="Primary" class="flex flex-1 min-w-0 items-center gap-1">
        {leftNav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class:list={["pill pill-ghost pill-md", isActive(href) && "bg-secondary"]}
          >
            {label}
          </a>
        ))}
      </nav>

      <div class="flex flex-1 min-w-0 items-center justify-center">
        <a href="/" class="flex items-center justify-center size-10 hover:opacity-70 transition-opacity" aria-label="Home">
          <Logo class="size-[26px]" />
        </a>
      </div>

      <div class="flex flex-1 min-w-0 items-center justify-end gap-5">
        <nav aria-label="Secondary" class="flex items-center gap-1">
          {rightNav.map(({ href, label }) => (
            <a
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
              class:list={["pill pill-ghost pill-md", isActive(href) && "bg-secondary"]}
            >
              {label}
            </a>
          ))}
        </nav>
        <ThemeToggle class="w-32 shrink-0" />
      </div>
    </div>

    {/* Compact — logo + hamburger */}
    <div class="flex lg:hidden items-center justify-between">
      <a href="/" class="flex items-center justify-center size-10 hover:opacity-70 transition-opacity" aria-label="Home">
        <Logo class="size-[26px]" />
      </a>
      <button
        type="button"
        id="menu-open"
        aria-label="Open menu"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex items-center justify-center size-11 rounded-full hover:bg-secondary transition-colors cursor-pointer"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

{/* ── Mobile menu overlay ─────────────────────────────────────────
    Figma: a rounded-[32px] card inset by the page gutter, sitting on a
    blurred scrim, with the theme toggle stretched across the bottom. */}
<div
  id="mobile-menu"
  class="mobile-overlay lg:hidden fixed inset-0 z-50"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
>
  <div class="panel absolute inset-x-[var(--page-px)] top-[var(--page-px)] rounded-[32px] bg-background shadow-[0_9px_7px_0_rgb(10_10_41_/_0.10)] p-3">
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center justify-center size-10 hover:opacity-70 transition-opacity" aria-label="Home">
        <Logo class="size-[26px]" />
      </a>
      <button
        type="button"
        id="menu-close"
        aria-label="Close menu"
        class="flex items-center justify-center size-11 rounded-full border border-border hover:bg-secondary transition-colors cursor-pointer"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <nav aria-label="Mobile" class="mt-3 flex flex-col gap-3">
      <div class="flex flex-col items-stretch gap-1">
        {leftNav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class:list={["pill pill-ghost pill-fluid", isActive(href) && "bg-secondary"]}
          >
            {label}
          </a>
        ))}
      </div>
      <hr class="border-t border-border" />
      <div class="flex flex-col items-stretch gap-1">
        {rightNav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class:list={["pill pill-ghost pill-fluid", isActive(href) && "bg-secondary"]}
          >
            {label}
          </a>
        ))}
      </div>
      <ThemeToggle class="w-full" />
    </nav>
  </div>
</div>

<style>
  .mobile-overlay {
    opacity: 0;
    visibility: hidden;
    background-color: var(--overlay-blur);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .mobile-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }
  .mobile-overlay .panel {
    transform: translateY(-14px);
    opacity: 0;
    transition:
      transform 0.34s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.22s ease;
  }
  .mobile-overlay.is-open .panel {
    transform: translateY(0);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-overlay,
    .mobile-overlay .panel {
      transition-duration: 0.01ms;
    }
    .mobile-overlay .panel {
      transform: none;
    }
  }
</style>

<script>
  const overlay = document.getElementById("mobile-menu")
  const openBtn = document.getElementById("menu-open")
  const closeBtn = document.getElementById("menu-close")

  if (overlay && openBtn && closeBtn) {
    const focusable = () =>
      Array.from(overlay.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))

    function open() {
      overlay!.classList.add("is-open")
      openBtn!.setAttribute("aria-expanded", "true")
      document.documentElement.style.overflow = "hidden"
      closeBtn!.focus()
      document.addEventListener("keydown", onKeydown)
    }
    function close() {
      overlay!.classList.remove("is-open")
      openBtn!.setAttribute("aria-expanded", "false")
      document.documentElement.style.overflow = ""
      document.removeEventListener("keydown", onKeydown)
      openBtn!.focus()
    }
    function onKeydown(e: KeyboardEvent) {
      if (e.key === "Escape") return close()
      if (e.key === "Tab") {
        const items = focusable()
        if (!items.length) return
        const first = items[0], last = items[items.length - 1]
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus()
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus()
        }
      }
    }

    openBtn.addEventListener("click", open)
    closeBtn.addEventListener("click", close)
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close()
    })
    focusable().forEach((el) => {
      if (el.tagName === "A") el.addEventListener("click", close)
    })
  }

  // ── Theme toggle (default light) ──────────────────────────────
  // The selected segment is styled from aria-pressed, so state and
  // presentation cannot drift apart.
  function syncToggles() {
    const dark = document.documentElement.classList.contains("dark")
    document.querySelectorAll<HTMLElement>("[data-theme-set]").forEach((b) => {
      b.setAttribute("aria-pressed", String((b.dataset.themeSet === "dark") === dark))
    })
  }
  function applyTheme(theme: string) {
    document.documentElement.classList.toggle("dark", theme === "dark")
    try {
      localStorage.setItem("theme", theme)
    } catch (e) {}
    syncToggles()
  }
  document.querySelectorAll<HTMLElement>("[data-theme-set]").forEach((b) => {
    b.addEventListener("click", () => applyTheme(b.dataset.themeSet!))
  })
  syncToggles()
</script>
