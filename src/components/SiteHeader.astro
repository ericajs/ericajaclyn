---
import Logo from "@/components/Logo.astro"
import ThemeToggle from "@/components/ThemeToggle.astro"
import NavLabel from "@/components/NavLabel.astro"

const leftNav = [
  { href: "/uxdesign", label: "UX Design" },
  { href: "/astrophotography", label: "Astrophotography" },
]
const rightNav = [
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
]

const currentPath = Astro.url.pathname
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href)
---
{/* Header is fluid edge-to-edge — no max-width, per the Figma build note.
    Responsive spec (≤640 / ≤768 / ≤1024 / >1024): menu button only and 56px
    tall at ≤768; full navbar and 68px from 769px. Figma's 12px padding
    overflows by the 46px theme toggle, so 11px lands the bar on 68. */}
<header class="w-full px-[var(--page-px)] py-1.5 min-h-14 flex items-center min-[769px]:py-[11px] min-[769px]:min-h-[68px]">
  <div class="w-full">

    {/* Desktop — links left, centered logo, links + theme toggle right.
        Equal 1fr side columns keep the logo centered while never letting
        either link group shrink under its content near 769px. */}
    <div class="hidden min-[769px]:grid grid-cols-[1fr_auto_1fr] items-center">
      <nav aria-label="Primary" class="flex items-center gap-1">
        {leftNav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class="pill pill-ghost pill-md"
          >
            <NavLabel label={label} active={isActive(href)} />
          </a>
        ))}
      </nav>

      <div class="flex items-center justify-center">
        <a href="/" class="flex items-center justify-center size-10 hover:opacity-70 transition-opacity" aria-label="Home">
          <Logo class="size-[26px]" />
        </a>
      </div>

      <div class="flex items-center justify-end gap-5">
        <nav aria-label="Secondary" class="flex items-center gap-1">
          {rightNav.map(({ href, label }) => (
            <a
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
              class="pill pill-ghost pill-md"
            >
              <NavLabel label={label} active={isActive(href)} />
            </a>
          ))}
        </nav>
        <ThemeToggle class="w-32 shrink-0" />
      </div>
    </div>

    {/* Compact — logo + hamburger */}
    <div class="flex min-[769px]:hidden items-center justify-between">
      <a href="/" class="flex items-center justify-center size-11 hover:opacity-70 transition-opacity" aria-label="Home">
        <Logo class="size-[26px]" />
      </a>
      <button
        type="button"
        id="menu-open"
        aria-label="Open menu"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex items-center justify-center size-11 rounded-full hover:bg-secondary transition-colors cursor-pointer"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

{/* ── Mobile menu overlay ─────────────────────────────────────────
    Figma Menu (expanded state), shown at ≤768 only. A rounded-[32px] card:
    four links in one group, then the theme toggle (44px tall). Variants:
      ≤640    — full-width card inset 12px on a blurred scrim; a 56px row
                with logo + close sits above the links (panel pt 6)
      641–768 — 320px card pinned top-right, inset 16px, no scrim; the page
                header's logo stays visible, so the card drops its own row
                and the close button floats 12px from its corner (pt 24) */}
<div
  id="mobile-menu"
  class="mobile-overlay min-[769px]:hidden fixed inset-0 z-50"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
>
  <div class="panel absolute inset-x-3 top-3 min-[641px]:inset-x-auto min-[641px]:right-4 min-[641px]:top-4 min-[641px]:w-80 rounded-[32px] bg-card shadow-[0_25px_25px_0_rgb(10_10_41_/_0.05)] pt-1.5 min-[641px]:pt-6">
    <div class="flex h-14 items-center justify-between px-3 py-1.5 min-[641px]:contents">
      <a href="/" class="flex min-[641px]:hidden items-center justify-center size-11 hover:opacity-70 transition-opacity" aria-label="Home">
        <Logo class="size-[26px]" />
      </a>
      <button
        type="button"
        id="menu-close"
        aria-label="Close menu"
        class="z-10 flex items-center justify-center size-11 rounded-full border border-input bg-[var(--input-surface)] hover:bg-secondary transition-colors cursor-pointer min-[641px]:absolute min-[641px]:right-3 min-[641px]:top-3"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    {/* Links use the sm/xs text/base step (18/26) */}
    <nav aria-label="Mobile" class="flex flex-col gap-6 p-3">
      <div class="flex flex-col items-stretch gap-2">
        {[...leftNav, ...rightNav].map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class="pill pill-ghost pill-fluid text-[18px] leading-[26px]"
          >
            <NavLabel label={label} active={isActive(href)} />
          </a>
        ))}
      </div>
      <ThemeToggle class="w-full h-11 [&>button]:min-h-0 [&>button]:self-stretch" />
    </nav>
  </div>
</div>

<style>
  .mobile-overlay {
    opacity: 0;
    visibility: hidden;
    background-color: var(--overlay-blur);
    /* Figma backdrop-blur/2xl: radius 40 → CSS blur(20px) */
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .mobile-overlay.is-open {
    opacity: 1;
    visibility: visible;
    /* Become visible at once on open so the close button can take focus;
       closing still waits for the fade before hiding */
    transition: opacity 0.25s ease, visibility 0s;
  }
  /* 641–768 variant has no scrim — the page stays visible beside the card */
  @media (min-width: 641px) {
    .mobile-overlay {
      background-color: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  .mobile-overlay .panel {
    transform: translateY(-14px);
    opacity: 0;
    transition:
      transform 0.34s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.22s ease;
  }
  .mobile-overlay.is-open .panel {
    transform: translateY(0);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-overlay,
    .mobile-overlay .panel {
      transition-duration: 0.01ms;
    }
    .mobile-overlay .panel {
      transform: none;
    }
  }
</style>

<script>
  const overlay = document.getElementById("mobile-menu")
  const openBtn = document.getElementById("menu-open")
  const closeBtn = document.getElementById("menu-close")

  if (overlay && openBtn && closeBtn) {
    // Rendered items only — the card's logo link is hidden from 641px
    const focusable = () =>
      Array.from(overlay.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
        .filter((el) => el.getClientRects().length > 0)

    function open() {
      overlay!.classList.add("is-open")
      openBtn!.setAttribute("aria-expanded", "true")
      document.documentElement.style.overflow = "hidden"
      closeBtn!.focus()
      document.addEventListener("keydown", onKeydown)
    }
    function close() {
      overlay!.classList.remove("is-open")
      openBtn!.setAttribute("aria-expanded", "false")
      document.documentElement.style.overflow = ""
      document.removeEventListener("keydown", onKeydown)
      openBtn!.focus()
    }
    function onKeydown(e: KeyboardEvent) {
      if (e.key === "Escape") return close()
      if (e.key === "Tab") {
        const items = focusable()
        if (!items.length) return
        const first = items[0], last = items[items.length - 1]
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus()
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus()
        }
      }
    }

    openBtn.addEventListener("click", open)
    closeBtn.addEventListener("click", close)
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close()
    })
    overlay.querySelectorAll("a[href]").forEach((el) => el.addEventListener("click", close))
  }

  // ── Theme toggle (default light) ──────────────────────────────
  // The selected segment is styled from aria-pressed, so state and
  // presentation cannot drift apart.
  function syncToggles() {
    const dark = document.documentElement.classList.contains("dark")
    document.querySelectorAll<HTMLElement>("[data-theme-set]").forEach((b) => {
      b.setAttribute("aria-pressed", String((b.dataset.themeSet === "dark") === dark))
    })
  }
  function applyTheme(theme: string) {
    document.documentElement.classList.toggle("dark", theme === "dark")
    try {
      localStorage.setItem("theme", theme)
    } catch (e) {}
    syncToggles()
  }
  document.querySelectorAll<HTMLElement>("[data-theme-set]").forEach((b) => {
    b.addEventListener("click", () => applyTheme(b.dataset.themeSet!))
  })
  syncToggles()
</script>
