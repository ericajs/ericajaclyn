---
import Logo from "@/components/Logo.astro"
import ThemeToggle from "@/components/ThemeToggle.astro"
import NavLabel from "@/components/NavLabel.astro"
import { primaryNav, secondaryNav, isActivePath, navHover, navLink } from "@/lib/nav"

const isActive = (href: string) => isActivePath(Astro.url.pathname, href)
---
{/* ── navMenu overlay ─────────────────────────────────────────────
    Figma navMenu (22878:79622), opened by navBar's menuButton and shown
    at ≤768 only. A rounded-[32px] card: four links in one group (ghost
    sm buttons, 14px, 44px tall, px 12, gap 8), then the theme toggle
    (44px tall). Variants:
      ≤640 xs — full-width card inset 12px on a blurred scrim; a 56px row
                with logo + close sits above the links (card pt 6)
      ≤768 sm — 320px card pinned top-right, inset 16px, no scrim; the page
                header's logo stays visible, so the card drops its own row
                and the close button floats 12px from its corner (pt 24) */}
<div
  id="nav-menu"
  class="nav-menu min-[769px]:hidden fixed inset-0 z-50"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
>
  <div class="panel absolute inset-x-3 top-3 min-[641px]:inset-x-auto min-[641px]:right-4 min-[641px]:top-4 min-[641px]:w-80 rounded-[32px] bg-card shadow-[0_25px_25px_0_rgb(10_10_41_/_0.05)] pt-1.5 min-[641px]:pt-6">
    <div class="flex h-14 items-center justify-between px-3 py-1.5 min-[641px]:contents">
      <a href="/" class="flex min-[641px]:hidden items-center justify-center size-11 hover:opacity-70 transition-opacity" aria-label="Home">
        <Logo class="size-[26px]" />
      </a>
      <button
        type="button"
        id="menu-close"
        aria-label="Close menu"
        class:list={["z-10 flex items-center justify-center size-11 rounded-full border border-input bg-[var(--input-surface)] transition-colors cursor-pointer min-[641px]:absolute min-[641px]:right-3 min-[641px]:top-3", navHover]}
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6L18 18" />
        </svg>
      </button>
    </div>

    <nav aria-label="Mobile" class="flex flex-col gap-6 p-3">
      <div class="flex flex-col items-stretch gap-2">
        {[...primaryNav, ...secondaryNav].map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class={`${navLink} pill-sm h-11`}
          >
            <NavLabel label={label} active={isActive(href)} />
          </a>
        ))}
      </div>
      <ThemeToggle class="w-full" />
    </nav>
  </div>
</div>

<style>
  .nav-menu {
    opacity: 0;
    visibility: hidden;
    background-color: var(--overlay-blur);
    /* Figma backdrop-blur/2xl: radius 40 → CSS blur(20px) */
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .nav-menu.is-open {
    opacity: 1;
    visibility: visible;
    /* Become visible at once on open so the close button can take focus;
       closing still waits for the fade before hiding */
    transition: opacity 0.25s ease, visibility 0s;
  }
  /* sm variant has no scrim — the page stays visible beside the card */
  @media (min-width: 641px) {
    .nav-menu {
      background-color: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  .nav-menu .panel {
    transform: translateY(-14px);
    opacity: 0;
    transition:
      transform 0.34s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.22s ease;
  }
  .nav-menu.is-open .panel {
    transform: translateY(0);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-menu,
    .nav-menu .panel {
      transition-duration: 0.01ms;
    }
    .nav-menu .panel {
      transform: none;
    }
  }
</style>

<script>
  const overlay = document.getElementById("nav-menu")
  // menuButton lives in navBar (NavBar.astro)
  const openBtn = document.getElementById("menu-open")
  const closeBtn = document.getElementById("menu-close")

  if (overlay && openBtn && closeBtn) {
    // Rendered items only — the card's logo link is hidden from 641px
    const focusable = () =>
      Array.from(overlay.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
        .filter((el) => el.getClientRects().length > 0)

    function open() {
      overlay!.classList.add("is-open")
      openBtn!.setAttribute("aria-expanded", "true")
      document.documentElement.style.overflow = "hidden"
      closeBtn!.focus()
      document.addEventListener("keydown", onKeydown)
    }
    function close() {
      overlay!.classList.remove("is-open")
      openBtn!.setAttribute("aria-expanded", "false")
      document.documentElement.style.overflow = ""
      document.removeEventListener("keydown", onKeydown)
      openBtn!.focus()
    }
    function onKeydown(e: KeyboardEvent) {
      if (e.key === "Escape") return close()
      if (e.key === "Tab") {
        const items = focusable()
        if (!items.length) return
        const first = items[0], last = items[items.length - 1]
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus()
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus()
        }
      }
    }

    openBtn.addEventListener("click", open)
    closeBtn.addEventListener("click", close)
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close()
    })
    overlay.querySelectorAll("a[href]").forEach((el) => el.addEventListener("click", close))
  }
</script>
