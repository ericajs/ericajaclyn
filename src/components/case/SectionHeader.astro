---
// Figma: sectionHeader (case study) — a top rule over a centered
// custom/heading-lg title (Caecilia Head Regular).
// Spec (>1024 | ≤1024 | ≤768 | ≤640):
//   row padding      24/12  24/12  12/6   12/6
//   content top pad    96     64     64     56
//   content bottom pad 48     48     40     32
//   heading          42/48  42/48  40/48  40/48
//   content max-width 512 at every width
// .heading-lg steps to 40px at ≤1024 for the Space page; the case study
// frames hold 42px through 769px, hence the min-[769px] override.
interface Props {
  title: string
  id?: string
}
const { title, id } = Astro.props
---
<header class="px-3 py-1.5 min-[769px]:px-6 min-[769px]:py-3">
  <div class="flex flex-col items-center border-t border-border">
    <div class="flex w-full max-w-lg flex-col items-center pt-14 pb-8 min-[641px]:pt-16 min-[641px]:pb-10 min-[769px]:pb-12 min-[1025px]:pt-24">
      <h2 id={id} class="heading-lg w-full text-center text-foreground min-[769px]:text-[42px]">{title}</h2>
    </div>
  </div>
</header>
