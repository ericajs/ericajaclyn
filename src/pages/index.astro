---
import { getCollection } from "astro:content"
import Layout from "@/layouts/main.astro"
import MainHeader from "@/components/MainHeader.astro"

const allWork = await getCollection("work")
const workSlides = allWork
  .filter((e) => e.data.heroOrder !== undefined)
  .sort((a, b) => a.data.heroOrder! - b.data.heroOrder!)
  .map((e) => ({
    title: e.data.title,
    // Build note lists the project descriptions as n/a — the pager shows the
    // project name only for UX Design case studies.
    description: "",
    // Only `treatment: "full"` entries get a case study page; the rest
    // land on the collection so the hero never links to a 404.
    href: e.data.treatment === "full" ? `/uxdesign/${e.id}` : "/uxdesign",
    cover: e.data.heroImage ?? e.data.coverImage ?? "",
    alt: e.data.heroAlt ?? e.data.coverAlt ?? "",
  }))

// Fifth hero slide — a Space piece that lives outside the work
// collection (Build note: Project 5, Cats Paw Nebula → Space). Name only,
// like the UX Design slides.
const astroSlide = {
  title: "Cats Paw Nebula",
  description: "",
  href: "/space#cats-paw",
  cover: "/space/6778-CatsPawNebula-SFReg1/6778-CatsPawNebula-SFreg1-Hero.jpg",
  alt: "Portrait hero of the Cat's Paw Nebula processed from James Webb Space Telescope imagery.",
}

const slides = [...workSlides, astroSlide]
const first = slides[0]
---
<Layout>
  <section class="hero bg-background">

    {/* ── Hero grid: copy + featured image ───────────────────────
        Side by side from lg up, stacked below. Both columns are fluid;
        mainHeader keeps its content capped at 384px and centered. */}
    <div class="hero-grid">
      <MainHeader />

      <div id="hero-media" class="hero-media bg-background" aria-live="polite">
        {slides.map((s, i) => (
          <div class="hero-slide absolute inset-0" data-slide={i} hidden={i !== 0}>
            {s.cover ? (
              <img
                src={s.cover}
                alt={s.alt}
                width="1000"
                height="1500"
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
                decoding="async"
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="h-full w-full flex items-center justify-center bg-muted">
                <span class="text-muted-foreground text-sm uppercase tracking-widest">{s.title}</span>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    {/* ── Pagination — sits under the image column from lg up ───── */}
    <div class="hero-pager-row">
      <div class="hero-pager-spacer" aria-hidden="true"></div>
      <div class="hero-pager">
        <div class="flex items-center gap-4 min-w-0 flex-1">
          <span id="hero-count" class="shrink-0 text-sm font-normal leading-none text-muted-foreground">
            1 of {slides.length}
          </span>
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <a
              id="hero-link"
              href={first.href}
              class="shrink-0 text-sm font-medium underline underline-offset-4 text-accent-foreground hover:opacity-70 transition-opacity"
            >
              {first.title}
            </a>
            <span id="hero-scope" class="hidden md:block min-w-0 flex-1 truncate text-sm text-muted-foreground">
              {first.description}
            </span>
          </div>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <button id="hero-prev" type="button" aria-label="Previous project" aria-controls="hero-media" class="pill pill-ghost size-10 shrink-0">
            {/* Icon / MoveLeft */}
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 8 2 12l4 4" /><path d="M2 12h20" />
            </svg>
          </button>
          <button id="hero-next" type="button" aria-label="Next project" aria-controls="hero-media" class="pill pill-ghost size-10 shrink-0">
            {/* Icon / MoveRight */}
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m18 8 4 4-4 4" /><path d="M2 12h20" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Grid rather than flex: with border-box padding, `flex: 1 1 0` would
     hand the padded copy column extra width and skew the 50/50 split. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-inline: var(--page-px);
    padding-top: 0.75rem;
  }

  .hero-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    /* Stacked: 480px at 360px wide → 1020px at 768px wide */
    height: clamp(30rem, calc(132.353vw + 3.5px), 63.75rem);
  }

  .hero-pager-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    min-height: 64px;
    padding-inline: var(--page-px);
  }

  .hero-pager {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .hero-pager-spacer {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-grid,
    .hero-pager-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero-media {
      /* Figma: 792px through xl, 840px at 2xl */
      height: clamp(49.5rem, 54.6875vw, 52.5rem);
    }
    .hero-pager-spacer {
      display: block;
    }
    .hero-pager {
      padding-inline: 0.5rem 1.5rem;
    }
  }

  .hero-slide[hidden] {
    display: none;
  }
</style>

<script define:vars={{ slides }}>
  const els = Array.from(document.querySelectorAll(".hero-slide"))
  const countEl = document.getElementById("hero-count")
  const linkEl = document.getElementById("hero-link")
  const scopeEl = document.getElementById("hero-scope")
  let i = 0

  function show(n) {
    i = (n + slides.length) % slides.length
    els.forEach((el, idx) => (el.hidden = idx !== i))
    if (countEl) countEl.textContent = `${i + 1} of ${slides.length}`
    if (linkEl) {
      linkEl.textContent = slides[i].title
      linkEl.setAttribute("href", slides[i].href)
    }
    if (scopeEl) scopeEl.textContent = slides[i].description
  }

  document.getElementById("hero-prev")?.addEventListener("click", () => show(i - 1))
  document.getElementById("hero-next")?.addEventListener("click", () => show(i + 1))
</script>
