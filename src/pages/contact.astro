---
import Layout from "@/layouts/main.astro"
import PageHero from "@/components/PageHero.astro"

// Replace YOUR_FORM_ID with the ID from formspree.io after creating your form
const FORMSPREE_ID = "YOUR_FORM_ID"
const LINKEDIN_URL = "https://www.linkedin.com/in/ericajaclyn/"
---
<Layout
  title="Contact — Erica Jaclyn Stein"
  description="Get in touch with Erica Jaclyn Stein for product design, design systems, and accessible UX work."
>
  <PageHero title="Contact" />

  <section class="max-w-6xl mx-auto px-6 pb-16 sm:pb-24">

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-stretch">

      {/* ── Left: invitation ──────────────────────────────────── */}
      <div class="flex flex-col gap-12 p-6 sm:p-10 lg:p-16">
        <div class="flex flex-col gap-8 max-w-lg">
          <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight">Ready to collaborate?</h2>
          <p class="text-base font-light leading-6">
            I’d love to hear from you! Whether you’re ready to start a project or just want to learn
            more about how I can help, feel free to reach out.
          </p>
        </div>

        <div>
          <a
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="pill pill-outline pill-fluid"
          >
            {/* Icon / ArrowUpRight */}
            <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14.1667 14.1667V5.83333H5.83333M14.1667 5.83333 5.83333 14.1667" />
            </svg>
            LinkedIn
          </a>
        </div>
      </div>

      {/* ── Right: form ───────────────────────────────────────── */}
      <div class="bg-muted rounded-3xl p-6 sm:p-10 lg:p-16">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-12">Get in touch</h2>

        <form
          id="contact-form"
          action={`https://formspree.io/f/${FORMSPREE_ID}`}
          method="POST"
          novalidate
          class="flex flex-col gap-8 max-w-xl"
        >
          <div class="flex flex-col gap-2">
            <label for="name" class="text-sm font-medium">Name</label>
            <input
              id="name" name="name" type="text" required
              autocomplete="name" placeholder="Your name"
              aria-describedby="name-error"
              class="contact-input h-10 w-full rounded-full border border-input px-3 text-base placeholder:text-muted-foreground focus:outline-none"
            />
            <p id="name-error" data-error class="hidden text-base text-destructive">Please provide a name.</p>
          </div>

          <div class="flex flex-col gap-2">
            <label for="email" class="text-sm font-medium">Email</label>
            <input
              id="email" name="email" type="email" required
              autocomplete="email" placeholder="example@mail.com"
              aria-describedby="email-error"
              class="contact-input h-10 w-full rounded-full border border-input px-3 text-base placeholder:text-muted-foreground focus:outline-none"
            />
            <p id="email-error" data-error class="hidden text-base text-destructive">Please provide an email address.</p>
          </div>

          <div class="flex flex-col gap-2">
            <label for="message" class="text-sm font-medium">Message</label>
            <textarea
              id="message" name="message" required rows={4}
              placeholder="Your message here"
              aria-describedby="message-error"
              class="contact-input min-h-24 w-full rounded-3xl border border-input p-4 text-base placeholder:text-muted-foreground focus:outline-none resize-y"
            ></textarea>
            <p id="message-error" data-error class="hidden text-base text-destructive">Please provide detail.</p>
          </div>

          {/* Honeypot */}
          <input type="text" name="_gotcha" class="hidden" aria-hidden="true" tabindex="-1" />

          <div class="flex justify-end">
            <button type="submit" class="pill pill-primary pill-md">
              {/* Icon / Send */}
              <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.16667 10.8333 1.66667 7.5 18.3333 1.66667 12.5 18.3333 9.16667 10.8333ZM18.3333 1.66667 9.16667 10.8333" />
              </svg>
              Send
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Field surface — Figma: custom/background (light #fff, dark white @ ~4.5%) */
  .contact-input {
    background-color: var(--input-surface);
  }
  /* Error border wins over the base border-input utility */
  .contact-input[aria-invalid="true"] {
    border-color: var(--destructive);
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null
  if (form) {
    const rules: { id: string; empty: string; invalid?: string; check?: (v: string) => boolean }[] = [
      { id: "name", empty: "Please provide a name." },
      {
        id: "email",
        empty: "Please provide an email address.",
        invalid: "Please enter a valid email address.",
        check: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v),
      },
      { id: "message", empty: "Please provide detail." },
    ]

    function setError(input: HTMLElement, errorEl: HTMLElement | null, msg: string | null) {
      if (msg) {
        input.classList.add("border-destructive")
        input.setAttribute("aria-invalid", "true")
        if (errorEl) {
          errorEl.textContent = msg
          errorEl.classList.remove("hidden")
        }
      } else {
        input.classList.remove("border-destructive")
        input.removeAttribute("aria-invalid")
        errorEl?.classList.add("hidden")
      }
    }

    form.addEventListener("submit", (e) => {
      let valid = true
      let firstInvalid: HTMLElement | null = null
      for (const r of rules) {
        const input = document.getElementById(r.id) as HTMLInputElement | null
        const errorEl = document.getElementById(`${r.id}-error`)
        if (!input) continue
        const v = input.value.trim()
        let msg: string | null = null
        if (!v) msg = r.empty
        else if (r.check && !r.check(v)) msg = r.invalid ?? r.empty
        setError(input, errorEl, msg)
        if (msg) {
          valid = false
          if (!firstInvalid) firstInvalid = input
        }
      }
      if (!valid) {
        e.preventDefault()
        firstInvalid?.focus()
      }
    })

    // Clear a field's error as the user corrects it
    form.querySelectorAll<HTMLElement>(".contact-input").forEach((input) => {
      input.addEventListener("input", () => {
        const errorEl = document.getElementById(`${input.id}-error`)
        setError(input, errorEl, null)
      })
    })
  }
</script>
